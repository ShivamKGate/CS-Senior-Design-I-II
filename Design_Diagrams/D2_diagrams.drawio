        <mxCell id="eE2" value="blocked / wrong format (E-12)" style="endArrow=block;html=1;strokeColor=#B85450;dashed=1;" edge="1" parent="1" source="GATE" target="MOL"><mxGeometry relative="1" as="geometry"/></mxCell>
