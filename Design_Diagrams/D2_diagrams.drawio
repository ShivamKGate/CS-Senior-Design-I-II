  <diagram id="d2-lifecycle" name="D2 Case Lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title2" value="HepatoFusion D2 — Case Lifecycle State Machine&#xa;States follow one study_id from cohort membership to viewer open. Red states are terminal non-scoring outcomes." style="text;html=1;align=center;fontStyle=1;fontSize=14;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s_init" value="● start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_coh" value="CohortMember" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_hp" value="HasPathology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_aw" value="AwaitingModalities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="130" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_sc" value="ScorableCandidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_scored" value="Scored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="130" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_pkg" value="InReviewPackage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="220" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_open" value="OpenedInViewer (terminal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="310" width="220" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="s_bno" value="Blocked_NoOutcomes (terminal, red)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="310" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_bim" value="Blocked_InsufficientModalities (terminal, red)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="720" y="310" width="320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s_vof" value="ViewerOpenFailed (terminal, red)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1140" y="400" width="260" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="I6 cohort list seen" style="endArrow=block;html=1;" edge="1" parent="1" source="s_init" target="s_coh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" value="localization_pointer resolves (I11 OK)" style="endArrow=block;html=1;" edge="1" parent="1" source="s_coh" target="s_hp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3" value="no non-pathology modality linked yet" style="endArrow=block;html=1;" edge="1" parent="1" source="s_hp" target="s_aw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4" value="outcomes = model_ready AND (radiology linked OR molecular linked)" style="endArrow=block;html=1;" edge="1" parent="1" source="s_aw" target="s_sc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t5" value="I13 writes score + used_inputs" style="endArrow=block;html=1;" edge="1" parent="1" source="s_sc" target="s_scored"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t6" value="I14 writes helper files" style="endArrow=block;html=1;" edge="1" parent="1" source="s_scored" target="s_pkg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t7" value="PathPresenter opens files (I15)" style="endArrow=block;html=1;" edge="1" parent="1" source="s_pkg" target="s_open"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="t8" value="outcomes = not_model_ready (UC-01 E1)" style="endArrow=block;html=1;strokeColor=#B85450;" edge="1" parent="1" source="s_hp" target="s_bno"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t9" value="outcomes = model_ready AND radiology not_linked AND molecular not_linked (D2 R-02)" style="endArrow=block;html=1;strokeColor=#B85450;" edge="1" parent="1" source="s_aw" target="s_bim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t10" value="PathPresenter cannot open overlay (OQ-02 / E-33)" style="endArrow=block;html=1;strokeColor=#B85450;" edge="1" parent="1" source="s_pkg" target="s_vof"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="leg2" value="Legend: green = scorable path  |  red = terminal non-scoring state  |  arrow label = event or condition that triggers the transition.  Transitions are enforced by the Modality integrator (§2.5) and Risk scorer (§2.6)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="1300" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
